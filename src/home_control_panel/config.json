{
  "title": "Yaoxing's Sweet Home",
  "serveHost": "monitor.yaoxing.online",
  "logLevel": "INFO",
  "timezone": "Europe/Stockholm",
  "warningInterval": 1,
  "tuiRefreshInterval": 10,
  "train": {
    "apiUrl": "https://api.trafikinfo.trafikverket.se/v2/data.json",
    "stationCode": "Sod",
    "apiFreqCheck": 60,
    "apiFreqControl": [
      {
        "from": 0,
        "to": 7,
        "intervalMin": 30
      },
      {
        "from": 7,
        "to": 9,
        "intervalMin": 2
      },
      {
        "from": 9,
        "to": 17,
        "intervalMin": 10
      },
      {
        "from": 17,
        "to": 19,
        "intervalMin": 2
      },
      {
        "from": 19,
        "to": 24,
        "intervalMin": 10
      }
    ],
    "stationUpdateInterval": 86400,
    "message": {
      "updateIntervalMin": 5,
      "scrollSpeed": 0.1,
      "margin": 50
    }
  },
  "sl": {
    "apiUrl": "https://transport.integration.sl.se/v1",
    "metroSiteId": 9116,
    "busSiteId": 1065,
    "refreshInterval": 60,
    "timeWindow": 120,
    "metroLineColors": {
      "10": "#0055A4",
      "11": "#0055A4",
      "13": "#E21A22",
      "14": "#E21A22",
      "17": "#3AAA35",
      "18": "#3AAA35",
      "19": "#3AAA35"
    }
  },
  "weather": {
    "apiUrl": "https://opendata-download-metfcst.smhi.se/api/category/snow1g/version/1/geotype/point/lon/{lon}/lat/{lat}/data.json",
    "lat": 59.346616,
    "lon": 18.034304,
    "refreshInterval": 300,
    "detailsInterval": 10,
    "probabilityWarningThreshold": [
      30,
      50,
      70
    ]
  },
  "stocks": {
    "symbols": ["NVDA", "TSLA", "AMZN", "GOOGL", "MSFT", "MDB", "AAPL"],
    "refreshInterval": 60
  },
  "homeassistant": {
    "apiUrl": "https://ha.yaoxing.online",
    "sensorRefreshInterval": 60,
    "areaRefreshInterval": 300,
    "lightsRefreshInterval": 5,
    "humidityWarningThreshold": [
      35,
      30,
      25
    ],
    "plantHumWarningThreshold": [
      50,
      40,
      30
    ],
    "sensors": {
      "temp": [
        "sensor.desk_motion_sensor_temperature",
        "sensor.wen_shi_du_chuan_gan_qi_temperature",
        "sensor.bed_temp_hum_temperature",
        "sensor.wen_shi_du_chuan_gan_qi_2_temperature"
      ],
      "hum": [
        "sensor.desk_motion_sensor_humidity",
        "sensor.bed_temp_hum_humidity",
        "sensor.wen_shi_du_chuan_gan_qi_humidity",
        "sensor.sensor.wen_shi_du_chuan_gan_qi_2_humidity"
      ],
      "plant_hum": [
        "sensor.plant_humidity_1_humidity",
        "sensor.plant_humidity_2_humidity",
        "sensor.plant_humidity_3_humidity"
      ],
      "illu": [
        "sensor.desk_light_sensor_illuminance"
      ]
    },
    "areas": {
      "Work Corner": [
        "switch.desk_light_switch_l3",
        "switch.jia_shi_qi_socket_1"
      ],
      "Living Room": [
        "switch.living_room_ceiling_lamp",
        "light.luo_di_deng",
        "light.fen_wei_deng"
      ],
      "Kitchen": [
        "switch.kitchen_power_strip_switch_5",
        "switch.table_lamp"
      ]
    },
    "scenes": [
      "scene.cinema",
      "scene.evening",
      "scene.day",
      "scene.night",
      "scene.good_night"
    ]
  }
}
