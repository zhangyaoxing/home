{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Start App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/home_control_panel/app.py",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        },
        {
            "name": "Start API Service",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/home_control_panel/api_service.py",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal"
        }
    ]
}